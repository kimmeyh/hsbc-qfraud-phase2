# Diff coverage (F177 change c, Sprint 31 D8). CI's push job sets
# COVERAGE_PROCESS_START to this file, so every Python process the tests
# start measures itself through coverage's startup hook (a1_coverage.pth)
# and the `subprocess` patch: hook and script tests run their code in a
# subprocess. `diff-cover` then fails a changed line in these sources that
# no test ran. Test files and fixtures are not measured.
# `branch = True` (F194, Sprint 32): a one-line `if bad: raise` that no
# test takes the raise of is a partial branch, which diff-cover's
# `--branch-coverage` reports as a violation; by line alone it read as
# tested whenever its condition ran.
[run]
branch = True
parallel = True
relative_files = True
patch = subprocess
data_file = ${COVERAGE_DATA_DIR-.}/.coverage
source =
    experiments/src
    experiments/phase2/src
    scripts
    .claude/hooks
omit =
    */test_*.py
    */conftest.py

[report]
# A test that writes a probe module and removes it (test_render_all.py's
# `render_all.missing_probe.py`) leaves measured data with no source;
# without this, `coverage xml` fails before diff-cover runs (d2cb10a).
ignore_errors = True

[paths]
source =
    ./
    */hsbc-qfraud-phase2/
